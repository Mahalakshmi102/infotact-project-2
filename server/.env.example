# StreamWeaver Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Replace with your MongoDB Atlas connection string if available:
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/streamweaver?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/streamweaver

# JWT Authentication Secret
JWT_SECRET=streamweaver_super_secret_jwt_key_2026_hari_key
JWT_EXPIRES_IN=7d

# File Upload Limit (bytes) - default 100MB
MAX_FILE_SIZE=104857600
